# Stellar testnet endpoints
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional Postgres persistence (Sprint 3)
DATABASE_URL=
DATABASE_SSL=false

# Optional file-fallback storage directory
# Local default: .nexusguard
# Vercel default: /tmp/nexusguard
NEXUSGUARD_STORE_DIR=

# Optional shared security state for multi-instance lockout/rate-limit
# Local example: .nexusguard/shared-security-state.json
# Vercel example: /tmp/nexusguard/shared-security-state.json
NEXUSGUARD_SHARED_STATE_PATH=

# Optional Redis connection for multi-instance shared state (e.g. Vercel)
# If provided, NexusGuard tries to use Redis first, with automatic file fallback if unavailable
REDIS_URL=

# Groq LLM configuration for live agent planning
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NexusGuard auth (required)
NEXUSGUARD_AUTH_SECRET=
# Wallet-only login allowlists (comma-separated Stellar public keys)
NEXUSGUARD_OPERATOR_WALLETS=
NEXUSGUARD_VIEWER_WALLETS=
NEXUSGUARD_AUTH_MAX_ATTEMPTS=5
NEXUSGUARD_AUTH_LOCK_MINUTES=10

# Optional UI default for payment destination
NEXT_PUBLIC_STELLAR_DESTINATION=

# Optional idempotency record retention in days (default: 7)
# Old signed-submit idempotency records are cleaned opportunistically; same-day records are preserved.
NEXUSGUARD_IDEMPOTENCY_RETENTION_DAYS=7

# Optional external blocklist URL for dynamic threat-intel (JSON array or plain-text, one domain per line)
# Fetched with a 5-minute in-memory cache; failures fall back silently without breaking decision flow
NEXUSGUARD_BLOCKLIST_URL=
