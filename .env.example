# Stellar testnet endpoints
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Groq LLM configuration for live agent planning
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NexusGuard auth (required)
NEXUSGUARD_AUTH_SECRET=
NEXUSGUARD_OPERATOR_EMAIL=operator@nexusguard.local
NEXUSGUARD_OPERATOR_PASSWORD=
NEXUSGUARD_VIEWER_EMAIL=viewer@nexusguard.local
NEXUSGUARD_VIEWER_PASSWORD=

# Optional UI default for payment destination
NEXT_PUBLIC_STELLAR_DESTINATION=
